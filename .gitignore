# --- DATA/: the paper cases are versioned, their outputs are not -------------
# Each DATA/<case>/ ships decks, meshes and scripts; every run writes its
# output in a subfolder (DATA/<case>/<run>/, runs/, out/, logs/, results/),
# which stays untracked.
DATA/**
!DATA/README.md
!DATA/*/
!DATA/*/*.dat
!DATA/*/*.py
!DATA/*/*.txt
!DATA/*/*.json
!DATA/*/*.md
!DATA/*/decks/
!DATA/*/decks/**
!DATA/*/grids/
!DATA/*/grids/**
!DATA/*/reference/
!DATA/*/reference/**
!DATA/*/mesh/
!DATA/*/mesh/*.py
!DATA/*/mesh/*.f90
!DATA/*/mesh/*/
!DATA/*/mesh/*/*.dat
!DATA/*/mesh/*/*.txt

# --- misc --------------------------------------------------------------------
.DS_Store
*.swp
*.ncu-rep
*.nsys-rep
*.sqlite

CLAUDE.md
.claude/
