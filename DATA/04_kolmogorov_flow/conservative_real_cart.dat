	ymin = -1.0
	ymax = 1.0
	zmin = -1.0
	zmax = 1.0
	gridpoint_x = 'uniform'
	gridpoint_y = 'uniform'
	gridpoint_z = 'uniform'
	mesh_file   = ''
	dims = 3
	tmax = 1.0E+09
	itmax = 6912
	nx = 8
	ny = 48
	nz = 8
	cart_dims(1) = 1
	cart_dims(2) = 1
	cart_dims(3) = 1
	CFL  = 0.5
	Dt   = 1.0E-03
	bc(1) = 'periodic'
	bc(2) = 'periodic'
	bc(3) = 'periodic'
	bc(4) = 'periodic'
	bc(5) = 'periodic'
	bc(6) = 'periodic'
	Trat = 1.0
