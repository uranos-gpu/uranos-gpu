&input_list
    ! scaling campaign C1: triperiodic flow at rest, 1024x1024x512
    xmin = 0.
    xmax = 6.283185307179586
    ymin = 0.
    ymax = 6.283185307179586
    zmin = 0.
    zmax = 6.283185307179586
    gridpoint_x = 'uniform'
    gridpoint_y = 'uniform'
    gridpoint_z = 'uniform'
    mesh_file   = ''
    dims = 3
    nx = 1024
    ny = 1024
    nz = 512
    cart_dims(1) = 0
    cart_dims(2) = 0
    cart_dims(3) = 0
    mpi_opt_level = 2
    cuda_aware    = .true.
    tmax  = 1.0E+12
    itmax = 10
    logical_CFL = .true.
    CFL = 0.5
    Dt  = 1.E-03
    n_step = 3
    bc(1) = 'periodic'
    bc(2) = 'periodic'
    bc(3) = 'periodic'
    bc(4) = 'periodic'
    bc(5) = 'periodic'
    bc(6) = 'periodic'
    Trat = 1.0
    inflow_profile = 'none'
    smooth_inflow  = .false.
    turb_inflow    = .false.
    Reynolds = 1000.0
    Mach     = 0.1
    Prandtl  = 0.72
    viscous  = .true.
    thermally_perfect_gas = 0
    scheme           = 'energy_preserving'
    ep_type          = 'JP'
    weno_order       = 5
    fd_order         = 6
    sensor           = 'ducros'
    ducrosToll       = 0.05
    diffusion_scheme = 'staggered'
    enable_limiter   = .false.
    LES       = .false.
    sgs_model = 'WALE'
    ic  = 'ambient'
    printres    = .false.
    restartStat = .false.
    itout = 1000000
    StFlg       = .false.
    rsOut = 1000000
    data_dir         = '08_multi_gpu_scaling/runs/scal_S_C1_n2'
    output_file_name = 'scal'
&end
