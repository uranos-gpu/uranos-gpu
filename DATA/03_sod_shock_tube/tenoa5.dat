&input_list

	! x interval
	xmin = -5.
	xmax = 5.
	
	! y interval 
	ymin = -1
	ymax = 1

	! z interval 
	zmin = -1
	zmax = 1

    ! grid type
    gridpoint_x = 'uniform'
    gridpoint_y = 'uniform'
    gridpoint_z = 'uniform'
    mesh_file = 'grids/fake_cartesian_shock_tube_x.txt'

    ! dimensions
    dims = 2
	
	! total simulation time
	tmax = 2.
    	itmax = 10000
	
	! number of nodes in each direction
	nx = 101
	ny = 5
	nz = 5

    ! number of procs per direction (0 if automatic)
    cart_dims(1) = 4
    cart_dims(2) = 1
    cart_dims(3) = 1
	
	! CFL value and time-step value
	CFL  = 0.5
	Dt   = 1.E-02

	! boundary conditions
	bc(1) = 'neumann'
	bc(2) = 'neumann'
	bc(3) = 'periodic'
	bc(4) = 'periodic'
	bc(5) = 'periodic'
	bc(6) = 'periodic'


    Trat = 1.0
	
	inflow_profile = 'none'
        smooth_inflow  = .false.
        turb_inflow    = .false.

	! Reynolds number
	Reynolds = 1000

	! Mach number
	Mach = 1.0

	! Prandtl number
	Prandtl = 0.71
	
	! flag to launch with CFL (true) or without CFL (false)
	thermally_perfect_gas = 1
	logical_CFL = .true.
        scheme      = 'hybrid_wenoEP'
        sensor      = 'density_jump'
        fd_order    = 6
        weno_order  = 5
        LES         = .false.
        sgs_model   = 'WALE'


	! Viscous therms flag
 	viscous = .false.
	Tref = 298.15
	species_name = "air"
	
	! Runge-Kutta sub-steps number
	n_step = 3
	
	! output interation
	itout = 10
        StOut = 100
        StFlg = .false.
	
	! initial condition
	ic = "shock_tube_x"
	
	! output file name
	output_file_name = "shock_tube_x"
	
	! data sub-directory name
	data_dir = "temp"
        mpi_opt_level=2
	cuda_aware = .true.

	
	

	mesh_file = 'DATA/03_sod_shock_tube/mesh_fake_cartesian.txt'
	data_dir = "03_sod_shock_tube/tenoa5"
	nx=200
	ny=5
	nz=5
	thermally_perfect_gas=0
	scheme='hybrid_tenoaEP'
	fd_order=6
	weno_order=5
	sensor='density_jump'
	logical_CFL=.false.
	Dt=1.0E-03
	itmax=1400
	itout=1400
	cart_dims(1)=1
	cart_dims(2)=1
	cart_dims(3)=1
&end
